{
  "$schema": "https://simtabi.com/gendia/schemas/scaffold-v1.json",
  "version": 1,
  "id": "rust",
  "name": "Rust (Cargo)",
  "description": "Rust crate with Cargo + clippy + rustfmt + integration tests.",
  "tags": ["rust", "cargo", "library"],
  "languages": ["rust"],
  "variables": {
    "name": {
      "description": "Crate name (kebab-case)",
      "required": true,
      "validate": "^[a-z][a-z0-9_-]*$"
    },
    "description": {
      "description": "One-line crate description",
      "required": true
    },
    "license": {
      "description": "SPDX license id (Rust often uses dual-license MIT OR Apache-2.0)",
      "default": "MIT",
      "choices": ["MIT", "Apache-2.0", "BSD-3-Clause", "ISC", "Unlicense"]
    },
    "author_name":   { "default": "Your Name" },
    "author_email":  { "default": "you@example.com" },
    "rust_edition":  { "default": "2021", "choices": ["2018", "2021", "2024"] },
    "year":          { "default": "${now.year}" }
  },
  "files": [
    { "src": "_common/README.md.tmpl",          "dest": "README.md" },
    { "src": "_common/CHANGELOG.md.tmpl",       "dest": "CHANGELOG.md" },
    { "src": "_common/CONTRIBUTING.md.tmpl",    "dest": "CONTRIBUTING.md" },
    { "src": "_common/CODE_OF_CONDUCT.md.tmpl", "dest": "CODE_OF_CONDUCT.md" },
    { "src": "_common/SECURITY.md.tmpl",        "dest": "SECURITY.md" },
    { "src": "_common/AGENTS.md.tmpl",          "dest": "AGENTS.md" },
    { "src": "_common/.gitignore",              "dest": ".gitignore" },
    { "src": "_common/.gitattributes",          "dest": ".gitattributes" },
    { "src": "_common/.editorconfig",           "dest": ".editorconfig" },
    { "src": "rust/Cargo.toml.tmpl",            "dest": "Cargo.toml" },
    { "src": "rust/rust-toolchain.toml.tmpl",   "dest": "rust-toolchain.toml" },
    { "src": "rust/rustfmt.toml",               "dest": "rustfmt.toml" },
    { "src": "rust/clippy.toml",                "dest": "clippy.toml" },
    { "src": "rust/lib.rs.tmpl",                "dest": "src/lib.rs" },
    { "src": "rust/integration.rs.tmpl",        "dest": "tests/integration.rs" }
  ],
  "after_scaffold": [
    {
      "kind": "license_text",
      "spdx": "${license}",
      "dest": "LICENSE",
      "holder": "${author_name}",
      "year": "${year}"
    },
    { "kind": "git_init", "default_branch": "main" },
    { "kind": "audit", "profile": "core" }
  ]
}
