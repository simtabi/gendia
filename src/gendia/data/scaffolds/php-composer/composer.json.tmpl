{
    "name": "${vendor}/${name}",
    "description": "${description}",
    "type": "library",
    "license": "${license}",
    "authors": [
        {
            "name": "${author_name}",
            "email": "${author_email}"
        }
    ],
    "require": {
        "php": ">=${php_version}"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "autoload": {
        "psr-4": {
            "${namespace}\\\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "${namespace}\\\\Tests\\\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests --level=8",
        "format": "php-cs-fixer fix"
    }
}
