{
  "$schema": "https://simtabi.com/gendia/schemas/scaffold-v1.json",
  "version": 1,
  "id": "php-composer",
  "name": "PHP (Composer-managed)",
  "description": "PHP package using Composer + PHPStan + PHP-CS-Fixer + PHPUnit.",
  "tags": ["php", "composer", "library"],
  "languages": ["php"],
  "variables": {
    "name": {
      "description": "Package name (kebab-case)",
      "required": true,
      "validate": "^[a-z][a-z0-9-]*$"
    },
    "vendor": {
      "description": "Composer vendor (your org / handle, lowercase)",
      "required": true,
      "validate": "^[a-z][a-z0-9-]*$"
    },
    "namespace": {
      "description": "PHP namespace (PascalCase; use ${name} converted)",
      "default": "${name}"
    },
    "description": {
      "description": "One-line package description",
      "required": true
    },
    "license": {
      "description": "SPDX license id",
      "default": "MIT",
      "choices": ["MIT", "Apache-2.0", "BSD-3-Clause", "ISC", "GPL-3.0-or-later", "MPL-2.0"]
    },
    "php_version":  { "default": "8.2" },
    "author_name":  { "default": "Your Name" },
    "author_email": { "default": "you@example.com" },
    "year":         { "default": "${now.year}" }
  },
  "files": [
    { "src": "_common/README.md.tmpl",          "dest": "README.md" },
    { "src": "_common/CHANGELOG.md.tmpl",       "dest": "CHANGELOG.md" },
    { "src": "_common/CONTRIBUTING.md.tmpl",    "dest": "CONTRIBUTING.md" },
    { "src": "_common/CODE_OF_CONDUCT.md.tmpl", "dest": "CODE_OF_CONDUCT.md" },
    { "src": "_common/SECURITY.md.tmpl",        "dest": "SECURITY.md" },
    { "src": "_common/AGENTS.md.tmpl",          "dest": "AGENTS.md" },
    { "src": "_common/.gitignore",              "dest": ".gitignore" },
    { "src": "_common/.gitattributes",          "dest": ".gitattributes" },
    { "src": "_common/.editorconfig",           "dest": ".editorconfig" },
    { "src": "php-composer/.php-version.tmpl",  "dest": ".php-version" },
    { "src": "php-composer/composer.json.tmpl", "dest": "composer.json" },
    { "src": "php-composer/phpstan.neon.tmpl",  "dest": "phpstan.neon.dist" },
    { "src": "php-composer/phpunit.xml.tmpl",   "dest": "phpunit.xml.dist" },
    { "src": "php-composer/Hello.php.tmpl",     "dest": "src/Hello.php" },
    { "src": "php-composer/HelloTest.php.tmpl", "dest": "tests/HelloTest.php" }
  ],
  "after_scaffold": [
    {
      "kind": "license_text",
      "spdx": "${license}",
      "dest": "LICENSE",
      "holder": "${author_name}",
      "year": "${year}"
    },
    { "kind": "git_init", "default_branch": "main" },
    { "kind": "audit", "profile": "core" }
  ]
}
