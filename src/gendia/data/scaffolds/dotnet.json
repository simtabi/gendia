{
  "$schema": "https://simtabi.com/gendia/schemas/scaffold-v1.json",
  "version": 1,
  "id": "dotnet",
  "name": ".NET (SDK-style csproj)",
  "description": ".NET class library + xUnit test project, with global.json SDK pin and Directory.Build.props.",
  "tags": ["dotnet", "csharp", "library"],
  "languages": ["csharp"],
  "variables": {
    "name": {
      "description": "Solution / project name (PascalCase)",
      "required": true,
      "validate": "^[A-Z][A-Za-z0-9_.]*$"
    },
    "description": {
      "description": "One-line project description",
      "required": true
    },
    "license": {
      "description": "SPDX license id",
      "default": "MIT",
      "choices": ["MIT", "Apache-2.0", "BSD-3-Clause", "ISC", "MPL-2.0"]
    },
    "dotnet_sdk":    { "default": "8.0.300" },
    "target_framework": { "default": "net8.0" },
    "author_name":   { "default": "Your Name" },
    "author_email":  { "default": "you@example.com" },
    "year":          { "default": "${now.year}" }
  },
  "files": [
    { "src": "_common/README.md.tmpl",          "dest": "README.md" },
    { "src": "_common/CHANGELOG.md.tmpl",       "dest": "CHANGELOG.md" },
    { "src": "_common/CONTRIBUTING.md.tmpl",    "dest": "CONTRIBUTING.md" },
    { "src": "_common/CODE_OF_CONDUCT.md.tmpl", "dest": "CODE_OF_CONDUCT.md" },
    { "src": "_common/SECURITY.md.tmpl",        "dest": "SECURITY.md" },
    { "src": "_common/AGENTS.md.tmpl",          "dest": "AGENTS.md" },
    { "src": "_common/.gitignore",              "dest": ".gitignore" },
    { "src": "_common/.gitattributes",          "dest": ".gitattributes" },
    { "src": "_common/.editorconfig",           "dest": ".editorconfig" },
    { "src": "dotnet/global.json.tmpl",         "dest": "global.json" },
    { "src": "dotnet/Directory.Build.props.tmpl", "dest": "Directory.Build.props" },
    { "src": "dotnet/solution.sln.tmpl",        "dest": "${name}.sln" },
    { "src": "dotnet/library.csproj.tmpl",      "dest": "src/${name}/${name}.csproj" },
    { "src": "dotnet/Class1.cs.tmpl",           "dest": "src/${name}/Class1.cs" },
    { "src": "dotnet/test.csproj.tmpl",         "dest": "tests/${name}.Tests/${name}.Tests.csproj" },
    { "src": "dotnet/Class1Tests.cs.tmpl",      "dest": "tests/${name}.Tests/Class1Tests.cs" }
  ],
  "after_scaffold": [
    {
      "kind": "license_text",
      "spdx": "${license}",
      "dest": "LICENSE",
      "holder": "${author_name}",
      "year": "${year}"
    },
    { "kind": "git_init", "default_branch": "main" },
    { "kind": "audit", "profile": "core" }
  ]
}
