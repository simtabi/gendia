{
  "$schema": "https://simtabi.com/gendia/schemas/scaffold-v1.json",
  "version": 1,
  "id": "python-poetry",
  "name": "Python (Poetry-managed)",
  "description": "Python package using Poetry + ruff + mypy + pytest, src/ layout (variant of python-uv).",
  "tags": ["python", "poetry", "library"],
  "languages": ["python"],
  "variables": {
    "name": {
      "description": "Package name (PEP 508 compliant; kebab-case)",
      "required": true,
      "validate": "^[a-z][a-z0-9-]*$"
    },
    "module": {
      "description": "Importable module name (snake_case)",
      "default": "${name}"
    },
    "description": {
      "description": "One-line project description",
      "required": true
    },
    "license": {
      "description": "SPDX license id",
      "default": "MIT",
      "choices": ["MIT", "Apache-2.0", "BSD-3-Clause", "ISC", "MPL-2.0", "GPL-3.0-or-later"]
    },
    "author_name":   { "default": "Your Name" },
    "author_email":  { "default": "you@example.com" },
    "python_version":{ "default": "3.12" },
    "year":          { "default": "${now.year}" }
  },
  "files": [
    { "src": "_common/README.md.tmpl",          "dest": "README.md" },
    { "src": "_common/CHANGELOG.md.tmpl",       "dest": "CHANGELOG.md" },
    { "src": "_common/CONTRIBUTING.md.tmpl",    "dest": "CONTRIBUTING.md" },
    { "src": "_common/CODE_OF_CONDUCT.md.tmpl", "dest": "CODE_OF_CONDUCT.md" },
    { "src": "_common/SECURITY.md.tmpl",        "dest": "SECURITY.md" },
    { "src": "_common/AGENTS.md.tmpl",          "dest": "AGENTS.md" },
    { "src": "_common/.gitignore",              "dest": ".gitignore" },
    { "src": "_common/.gitattributes",          "dest": ".gitattributes" },
    { "src": "_common/.editorconfig",           "dest": ".editorconfig" },
    { "src": "python-poetry/.python-version.tmpl",  "dest": ".python-version" },
    { "src": "python-poetry/pyproject.toml.tmpl",   "dest": "pyproject.toml" },
    { "src": "python-poetry/__init__.py.tmpl",      "dest": "src/${module}/__init__.py" },
    { "src": "python-poetry/test_basic.py.tmpl",    "dest": "tests/test_basic.py" }
  ],
  "after_scaffold": [
    {
      "kind": "license_text",
      "spdx": "${license}",
      "dest": "LICENSE",
      "holder": "${author_name}",
      "year": "${year}"
    },
    { "kind": "git_init", "default_branch": "main" },
    { "kind": "audit", "profile": "core" }
  ]
}
