{
  "$schema": "https://simtabi.com/gendia/schemas/scaffold-v1.json",
  "version": 1,
  "id": "java-gradle",
  "name": "Java + Gradle (Kotlin DSL)",
  "description": "Idiomatic Java application with Gradle Kotlin DSL build, JUnit 5 tests, and a toolchain pin. Run `gradle wrapper` once after scaffold to bake the wrapper jar.",
  "tags": ["java", "jvm", "gradle", "application"],
  "languages": ["java"],
  "variables": {
    "name": {
      "description": "Project / artifact name (lower-case slug)",
      "required": true,
      "validate": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "description": "One-line project description",
      "required": true
    },
    "license": {
      "description": "SPDX license id",
      "default": "Apache-2.0",
      "choices": [
        "MIT",
        "Apache-2.0",
        "BSD-3-Clause",
        "ISC",
        "MPL-2.0",
        "EPL-2.0",
        "LGPL-3.0-or-later"
      ]
    },
    "group_id":     { "default": "org.example" },
    "group_path":   { "default": "org/example", "description": "Source layout path mirroring group_id (e.g., org/example for org.example)" },
    "java_version": { "default": "21" },
    "junit_version": { "default": "5.11.0" },
    "author_name":  { "default": "Your Name" },
    "author_email": { "default": "you@example.com" },
    "year":         { "default": "${now.year}" }
  },
  "files": [
    { "src": "_common/README.md.tmpl",          "dest": "README.md" },
    { "src": "_common/CHANGELOG.md.tmpl",       "dest": "CHANGELOG.md" },
    { "src": "_common/CONTRIBUTING.md.tmpl",    "dest": "CONTRIBUTING.md" },
    { "src": "_common/CODE_OF_CONDUCT.md.tmpl", "dest": "CODE_OF_CONDUCT.md" },
    { "src": "_common/SECURITY.md.tmpl",        "dest": "SECURITY.md" },
    { "src": "_common/AGENTS.md.tmpl",          "dest": "AGENTS.md" },
    { "src": "_common/.gitignore",              "dest": ".gitignore" },
    { "src": "_common/.gitattributes",          "dest": ".gitattributes" },
    { "src": "_common/.editorconfig",           "dest": ".editorconfig" },
    { "src": "java-gradle/build.gradle.kts.tmpl",     "dest": "build.gradle.kts" },
    { "src": "java-gradle/settings.gradle.kts.tmpl",  "dest": "settings.gradle.kts" },
    { "src": "java-gradle/gradle.properties.tmpl",    "dest": "gradle.properties" },
    { "src": "java-gradle/.java-version.tmpl",        "dest": ".java-version" },
    { "src": "java-gradle/App.java.tmpl",             "dest": "src/main/java/${group_path}/App.java" },
    { "src": "java-gradle/AppTest.java.tmpl",         "dest": "src/test/java/${group_path}/AppTest.java" }
  ],
  "after_scaffold": [
    {
      "kind": "license_text",
      "spdx": "${license}",
      "dest": "LICENSE",
      "holder": "${author_name}",
      "year": "${year}"
    },
    { "kind": "git_init", "default_branch": "main" },
    { "kind": "audit", "profile": "core" }
  ]
}
