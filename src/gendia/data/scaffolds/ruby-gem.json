{
  "$schema": "https://simtabi.com/gendia/schemas/scaffold-v1.json",
  "version": 1,
  "id": "ruby-gem",
  "name": "Ruby gem (Bundler + RSpec)",
  "description": "Ruby gem with Gemfile + gemspec + RSpec + RuboCop + .ruby-version.",
  "tags": ["ruby", "gem", "bundler"],
  "languages": ["ruby"],
  "variables": {
    "name": {
      "description": "Gem name (kebab-case or snake_case)",
      "required": true,
      "validate": "^[a-z][a-z0-9_-]*$"
    },
    "module": {
      "description": "Ruby module name (PascalCase) — defaults to ${name}",
      "default": "${name}"
    },
    "description": {
      "description": "One-line gem description",
      "required": true
    },
    "license": {
      "description": "SPDX license id",
      "default": "MIT",
      "choices": ["MIT", "Apache-2.0", "BSD-3-Clause", "ISC", "GPL-3.0-or-later"]
    },
    "ruby_version": { "default": "3.3" },
    "author_name":  { "default": "Your Name" },
    "author_email": { "default": "you@example.com" },
    "year":         { "default": "${now.year}" }
  },
  "files": [
    { "src": "_common/README.md.tmpl",            "dest": "README.md" },
    { "src": "_common/CHANGELOG.md.tmpl",         "dest": "CHANGELOG.md" },
    { "src": "_common/CONTRIBUTING.md.tmpl",      "dest": "CONTRIBUTING.md" },
    { "src": "_common/CODE_OF_CONDUCT.md.tmpl",   "dest": "CODE_OF_CONDUCT.md" },
    { "src": "_common/SECURITY.md.tmpl",          "dest": "SECURITY.md" },
    { "src": "_common/AGENTS.md.tmpl",            "dest": "AGENTS.md" },
    { "src": "_common/.gitignore",                "dest": ".gitignore" },
    { "src": "_common/.gitattributes",            "dest": ".gitattributes" },
    { "src": "_common/.editorconfig",             "dest": ".editorconfig" },
    { "src": "ruby-gem/.ruby-version.tmpl",       "dest": ".ruby-version" },
    { "src": "ruby-gem/Gemfile.tmpl",             "dest": "Gemfile" },
    { "src": "ruby-gem/gemspec.tmpl",             "dest": "${name}.gemspec" },
    { "src": "ruby-gem/.rubocop.yml.tmpl",        "dest": ".rubocop.yml" },
    { "src": "ruby-gem/.rspec",                   "dest": ".rspec" },
    { "src": "ruby-gem/version.rb.tmpl",          "dest": "lib/${name}/version.rb" },
    { "src": "ruby-gem/main.rb.tmpl",             "dest": "lib/${name}.rb" },
    { "src": "ruby-gem/spec_helper.rb.tmpl",      "dest": "spec/spec_helper.rb" },
    { "src": "ruby-gem/version_spec.rb.tmpl",     "dest": "spec/version_spec.rb" }
  ],
  "after_scaffold": [
    {
      "kind": "license_text",
      "spdx": "${license}",
      "dest": "LICENSE",
      "holder": "${author_name}",
      "year": "${year}"
    },
    { "kind": "git_init", "default_branch": "main" },
    { "kind": "audit", "profile": "core" }
  ]
}
