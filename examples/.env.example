# gendia secrets — single source of truth for local dev, VPS, and Docker.
# -----------------------------------------------------------------------------
# Where does this file go?
# -----------------------------------------------------------------------------
# This file in the repo (examples/.env.example) is a TEMPLATE only. Never put
# real secrets here — it's tracked by git. Copy it to one of these locations:
#
#   1. Local dev / single-user (default, recommended):
#        ~/.config/gendia/.env                         (XDG-compliant)
#
#   2. VPS / system-wide deployment:
#        /etc/gendia/.env  + export GENDIA_ENV_FILE=/etc/gendia/.env
#        (or any path; gendia reads $GENDIA_ENV_FILE if set)
#
#   3. Per-project override:
#        any path; set GENDIA_ENV_FILE in that project's shell or Makefile
#
#   4. Docker / Compose:
#        bind-mount the host file at /config/.env inside the container.
#        Compose reads ${HOME}/.config/gendia/.env via env_file (see
#        docker-compose.yml in this repo).
#
#   5. Kubernetes:
#        mount each secret at /run/secrets/<name> via a Secret volume, then
#        set <KEY>_FILE=/run/secrets/<name> in the pod env (see the *_FILE
#        commented examples per credential below).
#
# Whichever location you pick, secure it:
#     chmod 600 ~/.config/gendia/.env
# gendia-env warns if it sees looser permissions than 0640.
# -----------------------------------------------------------------------------
# Quick start:
#     mkdir -p ~/.config/gendia
#     cp examples/.env.example ~/.config/gendia/.env
#     chmod 600 ~/.config/gendia/.env
#     $EDITOR ~/.config/gendia/.env
#
# Two patterns coexist in this file. Pick one per token:
#
#   1. DIRECT VALUE — for local dev and simple deployments:
#          GITHUB_TOKEN_MYORG=ghp_xxxxxxxx...
#
#   2. SECRET FILE  — for Docker / Compose / Kubernetes secret mounts.
#      gendia honours the standard `<KEY>_FILE` convention: when set, the
#      file at that path is read and its content becomes the value of <KEY>.
#      The token never appears in the container's env or process list.
#          GITHUB_TOKEN_MYORG_FILE=/run/secrets/github_token_myorg
#
# Both can appear in the same file. If both are set for the same key, the
# *_FILE form wins (so you can keep dev defaults inline and override per
# deployment with mounts).
#
# `bin/gendia-env` (a shell helper that ships with this repo) sources this
# file, resolves *_FILE references, and execs whatever you pass it. Use it
# to give docker-compose access to the same values via ${VAR} interpolation:
#     gendia-env docker compose up
#     gendia-env docker run --rm gendia:latest sync
# -----------------------------------------------------------------------------


# === Tool defaults (non-secret) ========================================
GENDIA_LOG_FORMAT=human
# GENDIA_LOG_LEVEL=INFO


# === Project root paths (referenced by gendia.json via ${VAR}) =========
# Keeping machine-specific paths in env (not in the tracked JSON) means the
# same gendia.json works for everyone on the team. Reference these from the
# project file as "root": "${MYORG_ROOT}".

MYORG_ROOT=~/projects/myorg
# REPOS_ROOT=~/projects


# === GitHub ============================================================
# PATs (classic or fine-grained). One token per scope is the safer pattern.
# Required scopes: `public_repo` for public repos, full `repo` for private.
# Mint at: https://github.com/settings/tokens
#
# Token names match the `credential_ref` keys in your gendia.json accounts.
# Add or remove lines below to mirror the accounts you actually use.

GITHUB_TOKEN_PERSONAL=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN_MYORG=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Docker / Kubernetes equivalents (uncomment when running in containers):
# GITHUB_TOKEN_PERSONAL_FILE=/run/secrets/github_token_personal
# GITHUB_TOKEN_MYORG_FILE=/run/secrets/github_token_myorg


# === GitLab ============================================================
# PAT scopes: `api`, `write_repository`.
# Mint at: https://gitlab.com/-/profile/personal_access_tokens (or your
# self-hosted equivalent).

GITLAB_TOKEN_INTERNAL=glpat-xxxxxxxxxxxxxxxxxxxx
# GITLAB_TOKEN_INTERNAL_FILE=/run/secrets/gitlab_token_internal


# === Bitbucket Cloud ===================================================
# Two formats supported:
#   1. App Password (Basic auth): "username:app_password"
#      Mint at: https://bitbucket.org/account/settings/app-passwords/
#   2. Workspace Access Token (Bearer): just the token, no colon
#      Mint at: workspace settings -> Access tokens

BITBUCKET_APP_PASSWORD=username:app_password_xxxxxxxxxxxxxx
# BITBUCKET_APP_PASSWORD_FILE=/run/secrets/bitbucket_app_password


# === Packagist =========================================================
# Used to fire the `update-package` webhook after a tag is pushed.
# Mint at: https://packagist.org/profile/  (Show API token)
# The `username` field is set in gendia.json `registries.packagist.username`.

PACKAGIST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PACKAGIST_API_TOKEN_FILE=/run/secrets/packagist_api_token


# === npm ===============================================================
# Granular Access token, type "Automation" (publish access required).
# Used by the `release` op for `npm publish`.
# Mint at: https://www.npmjs.com/settings/<user>/tokens

NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NPM_TOKEN_FILE=/run/secrets/npm_token


# === PyPI ==============================================================
# API token, prefixed with `pypi-`. Per-project scope is recommended.
# Used by the `release` op for `python -m twine upload`.
# Mint at: https://pypi.org/manage/account/token/

PYPI_API_TOKEN=pypi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PYPI_API_TOKEN_FILE=/run/secrets/pypi_api_token
